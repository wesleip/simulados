<%- include('partials/header') %>
<body class="bg-gray-100 font-sans antialiased flex flex-col min-h-screen">
    <header class="bg-blue-600 text-white p-6 text-center">
        <h1 class="text-3xl font-bold">Simulado Entry Level (LPIC-1)</h1>
    </header>

    <main class="py-12 px-6 flex-grow">
        <div class="max-w-7xl mx-auto">
            <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">Resultados do Simulado</h2>
            <p class="text-xl text-gray-700 mb-4 text-center">Você acertou <%= correctAnswers %> de <%= totalQuestions %> questões (<%= percentage.toFixed(2) %>%).</p>
            <% const passingScore = Math.ceil(totalQuestions * 0.7); // 70% das questões %>
            <p class="text-2xl font-bold text-center mb-8 <%= correctAnswers >= passingScore ? 'text-green-600' : 'text-red-600' %>">
                <%= correctAnswers >= passingScore ? 'Aprovado' : 'Reprovado' %>
            </p>
            <div class="flex gap-3 justify-center mb-6">
                <button id="filter-all" onclick="setFilter('all')"
                    class="py-2 px-5 rounded-lg font-semibold bg-blue-600 text-white transition duration-200">
                    Todas
                </button>
                <button id="filter-wrong" onclick="setFilter('wrong')"
                    class="py-2 px-5 rounded-lg font-semibold bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 transition duration-200">
                    Apenas erros
                </button>
            </div>

            <div id="results-list" class="space-y-6">
                <% answers.forEach((answer, index) => { %>
                    <div class="result-card p-6 rounded-lg shadow-md border-l-4 <%= answer.isCorrect ? 'bg-green-50 border-green-500' : 'bg-red-50 border-red-500' %>"
                         data-correct="<%= answer.isCorrect %>">
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">Questão <%= index + 1 %>: <%= answer.question %></h3>
                        <p class="text-gray-700">Sua resposta: <span class="<%= answer.isCorrect ? 'text-green-600' : 'text-red-600' %> font-medium"><%= answer.userAnswer %></span></p>
                        <p class="text-gray-700">Resposta correta: <span class="text-green-600 font-medium"><%= answer.correct %></span></p>
                    </div>
                <% }); %>
            </div>

            <script>
                function setFilter(mode) {
                    const cards = document.querySelectorAll('.result-card');
                    const btnAll = document.getElementById('filter-all');
                    const btnWrong = document.getElementById('filter-wrong');

                    cards.forEach(card => {
                        const isCorrect = card.dataset.correct === 'true';
                        card.style.display = (mode === 'wrong' && isCorrect) ? 'none' : '';
                    });

                    if (mode === 'wrong') {
                        btnWrong.className = 'py-2 px-5 rounded-lg font-semibold bg-red-600 text-white transition duration-200';
                        btnAll.className = 'py-2 px-5 rounded-lg font-semibold bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 transition duration-200';
                    } else {
                        btnAll.className = 'py-2 px-5 rounded-lg font-semibold bg-blue-600 text-white transition duration-200';
                        btnWrong.className = 'py-2 px-5 rounded-lg font-semibold bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 transition duration-200';
                    }
                }
            </script>
            <div class="mt-6 text-center">
                <a href="/select" class="bg-blue-600 text-white py-3 px-6 rounded-lg text-xl hover:bg-blue-700 transition duration-300">Refazer simulado</a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>