<%- include('partials/header') %>
<body class="bg-gray-100 font-sans antialiased flex flex-col min-h-screen">
    <header class="bg-blue-600 text-white p-6 text-center">
        <h1 class="text-3xl font-bold">Simulado Entry Level (LPIC-1)</h1>
    </header>

    <main class="py-12 px-6 flex-grow">
        <div class="max-w-7xl mx-auto text-center">
            <section class="mb-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">Ops! Algo deu errado</h2>
                <p class="text-xl text-gray-700"><%= message %></p>
            </section>

            <section class="space-x-4">
                <a href="<%= redirectUrl %>" class="bg-blue-600 text-white py-3 px-6 rounded-lg text-xl hover:bg-blue-700 transition duration-300">
                    <%= redirectText %>
                </a>
                <% if (typeof retryUrl !== 'undefined' && retryUrl) { %>
                <a href="<%= retryUrl %>" class="bg-green-600 text-white py-3 px-6 rounded-lg text-xl hover:bg-green-700 transition duration-300">
                    Refazer Simulado
                </a>
                <% } %>
            </section>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>